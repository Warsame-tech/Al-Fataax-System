# Copy this file to .env and adjust the values.

# API server
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MySQL (XAMPP defaults: user "root", empty password, port 3306)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=faatix

# Secret used to sign login sessions. Use a long random value in production.
JWT_SECRET=change-me-to-a-long-random-string
SESSION_DAYS=7

# ---- Multi-tenancy (each business can have its own database) ----
# Businesses open at <subdomain>.<BASE_DOMAIN> (needs wildcard DNS *.faatix.com → this server). Empty: /b/<subdomain> links only.
BASE_DOMAIN=
# Encrypts the per-business database passwords (AES-256-GCM). REQUIRED in production. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it safe and never change it once businesses exist (their database passwords could no longer be read).
TENANT_DB_KEY=
# dedicated (default: a new database per new business) | shared (new businesses use the central database)
TENANT_DB_MODE=dedicated
# Create a restricted MySQL user per business database (needs CREATE USER + GRANT). false = reuse DB_USER.
TENANT_DB_USERS=true
# Host part of those MySQL users ('%' = any host)
TENANT_DB_USER_HOST=%
# Where backups are written (mount a volume here on Railway). Default: server/backups
BACKUP_DIR=
# The public website(s) allowed to post the contact / demo form, comma separated
WEBSITE_ORIGIN=
# true = the old self sign-up (POST /api/auth/register) works again — for a local demo only
ALLOW_SELF_SIGNUP=false
